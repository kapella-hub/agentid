#!/usr/bin/env bash
# Git pre-commit hook — lint & format check before commit
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or: cd .git/hooks && ln -s ../../scripts/pre-commit pre-commit

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# ── Backend checks (if Python files changed) ─────────────────────────────
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -n "$PYTHON_FILES" ]; then
    echo -e "\n${YELLOW}[1/3] Ruff lint check...${NC}"
    if command -v ruff &>/dev/null; then
        cd apps/api
        ruff check . --quiet || {
            echo -e "${RED}Ruff lint failed. Run 'ruff check --fix .' to auto-fix.${NC}"
            exit 1
        }
        echo -e "${GREEN}  ✓ Lint passed${NC}"

        echo -e "${YELLOW}[2/3] Ruff format check...${NC}"
        ruff format --check . --quiet || {
            echo -e "${RED}Ruff format failed. Run 'ruff format .' to auto-format.${NC}"
            exit 1
        }
        echo -e "${GREEN}  ✓ Format passed${NC}"
        cd ../..
    else
        echo -e "${YELLOW}  ⚠ ruff not installed, skipping Python checks${NC}"
    fi
else
    echo -e "${YELLOW}[1-2/3] No Python files changed, skipping backend checks${NC}"
fi

# ── Frontend checks (if TS/TSX files changed) ───────────────────────────
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -n "$FRONTEND_FILES" ]; then
    echo -e "${YELLOW}[3/3] ESLint check...${NC}"
    if [ -f frontend/node_modules/.bin/next ]; then
        cd frontend
        npm run lint --silent 2>/dev/null || {
            echo -e "${RED}ESLint failed. Run 'cd frontend && npm run lint' to see details.${NC}"
            exit 1
        }
        echo -e "${GREEN}  ✓ ESLint passed${NC}"
        cd ..
    else
        echo -e "${YELLOW}  ⚠ Frontend deps not installed, skipping ESLint${NC}"
    fi
else
    echo -e "${YELLOW}[3/3] No frontend files changed, skipping ESLint${NC}"
fi

echo -e "\n${GREEN}All pre-commit checks passed!${NC}"
