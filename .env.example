# ===========================================
# AgentID Environment Configuration
# Copy to .env and fill in real values
# ===========================================

# --- Core ---
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=change-me-to-random-64-chars
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agentid:localdev@localhost:5432/agentid

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Email Provider (Mailgun) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=agentid.io
MAILGUN_WEBHOOK_SIGNING_KEY=

# --- Phone Provider (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Vault / KMS ---
KMS_KEY_ID=
# For local dev, uses software encryption fallback
VAULT_MASTER_KEY=local-dev-master-key-change-in-prod

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentid-api
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_PROVISION=10/hour
