# ===========================================
# AgentID Environment Configuration
# Copy to .env and fill in real values
#
# All variables are prefixed with AGENTID_
# to match Pydantic settings configuration.
# ===========================================

# --- Core ---
AGENTID_DEBUG=false

# --- Database ---
AGENTID_DATABASE_URL=postgresql+asyncpg://agentid:localdev@localhost:5432/agentid

# --- Redis ---
AGENTID_REDIS_URL=redis://localhost:6379/0

# --- Auth ---
AGENTID_JWT_SECRET_KEY=change-me-to-random-64-chars
AGENTID_JWT_ALGORITHM=HS256
AGENTID_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AGENTID_AGENT_TOKEN_EXPIRE_MINUTES=60

# --- Email Provider (Mailgun) ---
AGENTID_MAILGUN_API_KEY=
AGENTID_MAILGUN_DOMAIN=agentid.io
AGENTID_MAILGUN_WEBHOOK_SIGNING_KEY=

# --- Phone Provider (Twilio) ---
AGENTID_TWILIO_ACCOUNT_SID=
AGENTID_TWILIO_AUTH_TOKEN=

# --- Payments (Stripe) ---
AGENTID_STRIPE_SECRET_KEY=
AGENTID_STRIPE_WEBHOOK_SECRET=

# --- Vault / KMS ---
# For local dev, uses software encryption fallback.
# In production, set to a base64-encoded 32-byte key or use KMS.
AGENTID_VAULT_MASTER_KEY=

# --- Rate Limiting ---
AGENTID_RATE_LIMIT_PER_MINUTE=60
